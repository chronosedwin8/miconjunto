{
  "name": "miconjunto",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n web,jobs -c cyan,magenta \"next dev\" \"tsx jobs/worker.ts\"",
    "dev:web": "next dev",
    "build": "prisma generate && next build",
    "start": "concurrently -k -n web,jobs -c cyan,magenta \"next start\" \"tsx jobs/worker.ts\"",
    "start:web": "next start",
    "worker": "tsx jobs/worker.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "seed": "tsx prisma/seed/index.ts",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force --skip-seed && npm run seed",
    "db:test:prepare": "tsx scripts/prepare-test-db.ts",
    "screens": "tsx scripts/screens.ts",
    "icons": "tsx scripts/generate-icons.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@aws-sdk/client-s3": "^3.1141.0",
    "@base-ui/react": "^1.8.0",
    "@node-rs/argon2": "^2.2.1",
    "@prisma/client": "^6.19.3",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "@react-pdf/renderer": "^4.9.0",
    "@serwist/next": "^9.5.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "exceljs": "^4.4.0",
    "html5-qrcode": "^2.3.8",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^1.48.0",
    "next": "15.5.26",
    "next-auth": "^5.0.0-beta.32",
    "next-intl": "^4.14.7",
    "next-themes": "^0.4.6",
    "nodemailer": "^8.0.11",
    "otplib": "^13.5.0",
    "pg": "^8.23.0",
    "pg-boss": "^10.4.2",
    "prisma": "^6.19.3",
    "qrcode": "^1.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "recharts": "^3.10.1",
    "sanitize-html": "^2.17.7",
    "serwist": "^9.5.12",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.1",
    "@types/web-push": "^3.6.4",
    "concurrently": "^10.0.5",
    "dotenv": "^18.0.4",
    "eslint": "^9",
    "eslint-config-next": "15.5.26",
    "husky": "^9.1.7",
    "prettier": "^3.9.9",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.2"
  },
  "prisma": {
    "seed": "tsx prisma/seed/index.ts"
  },
  "engines": {
    "node": ">=20"
  }
}
