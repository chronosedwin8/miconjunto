model Persona {
  id                           String        @id @default(cuid())
  conjuntoId                   String
  conjunto                     Conjunto      @relation(fields: [conjuntoId], references: [id])
  usuarioId                    String?
  usuario                      Usuario?      @relation(fields: [usuarioId], references: [id])
  tipoDocumento                TipoDocumento @default(CC)
  numeroDocumento              String
  nombres                      String
  apellidos                    String
  fechaNacimiento              DateTime?
  genero                       String?
  fotoUrl                      String?
  telefono                     String?
  email                        String?
  eps                          String?
  contactoEmergenciaNombre     String?
  contactoEmergenciaTelefono   String?
  ocupacion                    String?
  movilidadReducida            Boolean       @default(false)
  movilidadDescripcion         String?
  requiereAsistenciaEvacuacion Boolean       @default(false)
  tipoSangre                   String?
