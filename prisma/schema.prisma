  enseres             Json            @default("[]")
  pazYSalvoVerificado Boolean         @default(false)
  estado              EstadoSolicitud @default(SOLICITADA)
  aprobadaPorId       String?
  observaciones       String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  deletedAt           DateTime?

  @@index([conjuntoId])
}

// ─────────────────────────────── GOBIERNO ───────────────────────────────

model Asamblea {
  id                    String               @id @default(cuid())
  conjuntoId            String
  conjunto              Conjunto             @relation(fields: [conjuntoId], references: [id])
  titulo                String
  tipo                  TipoAsamblea
  modalidad             ModalidadAsamblea    @default(PRESENCIAL)
  fecha                 DateTime
  lugar                 String?
  enlace                String?
  convocatoriaTexto     String?
  convocatoriaEnviadaEn DateTime?
  ordenDelDia           Json                 @default("[]") // [{orden, titulo, descripcion, votacionId?}]
  quorumRequerido       Decimal              @default(50.000001) @db.Decimal(9, 6)
  limitePoderes         Int                  @default(2)
  estado                EstadoAsamblea       @default(BORRADOR)
  codigoAsistencia      String               @unique @default(cuid())
  actaTexto             String?
  actaCodigo            String?              @unique
  presidenteNombre      String?
  secretarioNombre      String?
  firmaPresidente       String?
  firmaSecretario       String?
  actaPublicadaEn       DateTime?
  compromisos           Json                 @default("[]")
  iniciadaEn            DateTime?
  finalizadaEn          DateTime?
  asistencias           AsistenciaAsamblea[]
  poderes               PoderAsamblea[]
  votaciones            Votacion[]
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  deletedAt             DateTime?

  @@index([conjuntoId])
}

model AsistenciaAsamblea {
  id            String         @id @default(cuid())
  conjuntoId    String
  asambleaId    String
  asamblea      Asamblea       @relation(fields: [asambleaId], references: [id])
  unidadId      String
  unidad        Unidad         @relation(fields: [unidadId], references: [id])
  personaNombre String?
  usuarioId     String?
  tipo          TipoAsistencia @default(PRESENCIAL)
  coeficiente   Decimal        @db.Decimal(9, 6)
  poderId       String?
  registradaEn  DateTime       @default(now())
  salidaEn      DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?

  @@unique([asambleaId, unidadId])
  @@index([conjuntoId])
}

model PoderAsamblea {
  id                 String      @id @default(cuid())
  conjuntoId         String
  asambleaId         String
  asamblea           Asamblea    @relation(fields: [asambleaId], references: [id])
  unidadId           String // unidad que otorga el poder
  otorganteNombre    String
  apoderadoNombre    String
  apoderadoDocumento String?
  apoderadoUsuarioId String?
  documentoUrl       String?
  estado             EstadoPoder @default(PENDIENTE)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  deletedAt          DateTime?

  @@unique([asambleaId, unidadId])
  @@index([conjuntoId])
}

model Votacion {
  id          String         @id @default(cuid())
  conjuntoId  String
  conjunto    Conjunto       @relation(fields: [conjuntoId], references: [id])
  asambleaId  String?
  asamblea    Asamblea?      @relation(fields: [asambleaId], references: [id])
  puntoOrden  Int?
  pregunta    String
  descripcion String?
  opciones    Json // [{id, texto}]
  tipoMayoria TipoMayoria    @default(SIMPLE)
  ponderacion Ponderacion    @default(COEFICIENTE)
  quienVota   QuienVota      @default(PROPIETARIOS)
  secreto     Boolean        @default(false)
  inicio      DateTime       @default(now())
  fin         DateTime
  estado      EstadoVotacion @default(ABIERTA)
  resultado   Json?
  codigoActa  String?        @unique
  votos       Voto[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  deletedAt   DateTime?

  @@index([conjuntoId])
}

model Voto {
  id              String    @id @default(cuid())
  conjuntoId      String
  votacionId      String
  votacion        Votacion  @relation(fields: [votacionId], references: [id])
  unidadId        String
  unidad          Unidad    @relation(fields: [unidadId], references: [id])
  opcionId        String
  usuarioId       String?
  votanteNombre   String?
  coeficiente     Decimal   @db.Decimal(9, 6)
  porPoder        Boolean   @default(false)
  comprobanteHash String    @unique
  emitidoEn       DateTime  @default(now())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  @@unique([votacionId, unidadId])
  @@index([conjuntoId])
}

model MiembroConsejo {
  id            String       @id @default(cuid())
  conjuntoId    String
  personaId     String?
  usuarioId     String?
  nombre        String
  unidadCodigo  String?
  cargo         CargoConsejo @default(VOCAL)
  periodoInicio DateTime
  periodoFin    DateTime
  activo        Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  deletedAt     DateTime?

  @@index([conjuntoId])
}

model ReunionConsejo {
  id         String    @id @default(cuid())
  conjuntoId String
  fecha      DateTime
  tema       String
  asistentes String[]
  actaTexto  String?
  decisiones String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  @@index([conjuntoId])
}

// ─────────────────────────────── ACTIVOS, MANTENIMIENTO, PROVEEDORES ───────────────────────────────

model Activo {
  id            String              @id @default(cuid())
  conjuntoId    String
  conjunto      Conjunto            @relation(fields: [conjuntoId], references: [id])
  nombre        String
  categoria     String
  ubicacion     String?
  zonaId        String?
  zona          ZonaComun?          @relation(fields: [zonaId], references: [id])
  marca         String?
  modelo        String?
  serie         String?
  fechaCompra   DateTime?
  valor         Decimal?            @db.Decimal(14, 2)
  vidaUtilAnios Int?
  proveedorId   String?
  proveedor     Proveedor?          @relation(fields: [proveedorId], references: [id])
  garantiaVence DateTime?
  fotos         String[]
  manuales      String[]
  codigoQr      String              @unique @default(cuid())
  estado        EstadoActivo        @default(OPERATIVO)
  notas         String?
  planes        PlanMantenimiento[]
  ordenes       OrdenTrabajo[]
  tickets       Ticket[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  deletedAt     DateTime?

  @@index([conjuntoId])
}

model PlanMantenimiento {
  id               String            @id @default(cuid())
  conjuntoId       String
  activoId         String?
  activo           Activo?           @relation(fields: [activoId], references: [id])
  zonaId           String?
  nombre           String
  tipo             TipoMantenimiento @default(PREVENTIVO)
  frecuenciaDias   Int
  proximaFecha     DateTime
  ultimaEjecucion  DateTime?
  responsableId    String?
  proveedorId      String?
  proveedor        Proveedor?        @relation(fields: [proveedorId], references: [id])
  checklist        String[]
  costoEstimado    Decimal?          @db.Decimal(14, 2)
  diasAnticipacion Int               @default(7)
  activoPlan       Boolean           @default(true)
  ordenes          OrdenTrabajo[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deletedAt        DateTime?

  @@index([conjuntoId])
}

model OrdenTrabajo {
  id              String             @id @default(cuid())
  conjuntoId      String
  numero          Int
  origen          OrigenOrden        @default(MANUAL)
  planId          String?
  plan            PlanMantenimiento? @relation(fields: [planId], references: [id])
  ticketId        String?
  activoId        String?
  activo          Activo?            @relation(fields: [activoId], references: [id])
  zonaId          String?
  proveedorId     String?
  proveedor       Proveedor?         @relation(fields: [proveedorId], references: [id])
  asignadoAId     String?
  titulo          String
  descripcion     String?
  fechaProgramada DateTime
  fechaInicio     DateTime?
  fechaCierre     DateTime?
  costo           Decimal?           @db.Decimal(14, 2)
  checklist       Json               @default("[]") // [{item, ok}]
  evidencias      String[]
  estado          EstadoOrden        @default(PENDIENTE)
  notasCierre     String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  deletedAt       DateTime?

  @@unique([conjuntoId, numero])
  @@index([conjuntoId])
}

model Proveedor {
  id                    String                  @id @default(cuid())
  conjuntoId            String
  conjunto              Conjunto                @relation(fields: [conjuntoId], references: [id])
  nit                   String
  razonSocial           String
  categoria             String
  contactoNombre        String?
  telefono              String?
  email                 String?
  direccion             String?
  tarifas               String?
  directorioComunitario Boolean                 @default(false)
  beneficioComunidad    String?
  calificacionPromedio  Decimal                 @default(0) @db.Decimal(3, 2)
  usuarioId             String?
  activo                Boolean                 @default(true)
  documentos            DocumentoProveedor[]
  calificaciones        CalificacionProveedor[]
  contratos             Contrato[]
  activos               Activo[]
  planes                PlanMantenimiento[]
  ordenes               OrdenTrabajo[]
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  deletedAt             DateTime?

  @@index([conjuntoId])
}

model DocumentoProveedor {
  id          String           @id @default(cuid())
  conjuntoId  String
  proveedorId String
  proveedor   Proveedor        @relation(fields: [proveedorId], references: [id])
  tipo        TipoDocProveedor
  archivoUrl  String?
  vence       DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  deletedAt   DateTime?

  @@index([conjuntoId])
}

model CalificacionProveedor {
  id            String    @id @default(cuid())
  conjuntoId    String
  proveedorId   String
  proveedor     Proveedor @relation(fields: [proveedorId], references: [id])
  usuarioId     String
  usuarioNombre String?
  puntaje       Int
  comentario    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  @@unique([proveedorId, usuarioId])
  @@index([conjuntoId])
}

model Contrato {
  id                   String         @id @default(cuid())
  conjuntoId           String
  proveedorId          String
  proveedor            Proveedor      @relation(fields: [proveedorId], references: [id])
  objeto               String
  valor                Decimal        @db.Decimal(14, 2)
  inicio               DateTime
  fin                  DateTime
  renovacionAutomatica Boolean        @default(false)
  diasAlerta           Int            @default(30)
  documentoUrl         String?
  estado               EstadoContrato @default(VIGENTE)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  deletedAt            DateTime?

  @@index([conjuntoId])
}

model Presupuesto {
  id         String             @id @default(cuid())
  conjuntoId String
  anio       Int
  estado     EstadoPresupuesto  @default(BORRADOR)
  asambleaId String?
  notas      String?
  rubros     RubroPresupuesto[]
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  deletedAt  DateTime?

  @@unique([conjuntoId, anio])
}

model RubroPresupuesto {
  id             String      @id @default(cuid())
  conjuntoId     String
  presupuestoId  String
  presupuesto    Presupuesto @relation(fields: [presupuestoId], references: [id])
  tipo           TipoRubro
  nombre         String
  cuentaContable String?
  valorAnual     Decimal     @db.Decimal(14, 2)
  gastos         Gasto[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  deletedAt      DateTime?

  @@index([conjuntoId])
}

model Gasto {
  id             String            @id @default(cuid())
  conjuntoId     String
  rubroId        String?
  rubro          RubroPresupuesto? @relation(fields: [rubroId], references: [id])
  proveedorId    String?
  ordenTrabajoId String?
  fecha          DateTime
  descripcion    String
  valor          Decimal           @db.Decimal(14, 2)
  comprobanteUrl String?
  estado         EstadoGasto       @default(PENDIENTE_APROBACION)
  aprobadoPorId  String?
  cuentaContable String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  deletedAt      DateTime?

  @@index([conjuntoId])
}

model Empleado {
  id           String    @id @default(cuid())
  conjuntoId   String
  nombre       String
  documento    String?
  cargo        String
  turno        String?
  telefono     String?
  fotoUrl      String?
  epsVence     DateTime?
  arlVence     DateTime?
  fechaIngreso DateTime?
  documentos   String[]
  activo       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  @@index([conjuntoId])
}

// ─────────────────────────────── EMERGENCIAS ───────────────────────────────

model PlanEmergencia {
  id                  String    @id @default(cuid())
  conjuntoId          String    @unique
  puntosEncuentro     Json      @default("[]")
  instrucciones       String?
  telefonosEmergencia Json      @default("[]")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?
}

model Brigadista {
  id          String        @id @default(cuid())
  conjuntoId  String
  personaId   String?
  nombre      String
  rol         RolBrigadista
  torreNombre String?
  telefono    String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?

  @@index([conjuntoId])
}

model Simulacro {
  id                  String    @id @default(cuid())
  conjuntoId          String
  fecha               DateTime
  tipo                String
  participantes       Int       @default(0)
  tiempoEvacuacionMin Int?
  observaciones       String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  @@index([conjuntoId])
}

// ─────────────────────────────── TRANSVERSALES ───────────────────────────────

model Auditoria {
  id               String    @id @default(cuid())
  conjuntoId       String?
  conjunto         Conjunto? @relation(fields: [conjuntoId], references: [id])
  usuarioId        String?
  usuarioNombre    String?
  impersonadoPorId String?
  accion           String
  entidad          String
  entidadId        String?
  antes            Json?
  despues          Json?
  ip               String?
  userAgent        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  @@index([conjuntoId, createdAt])
  @@index([entidad, entidadId])
}

model Adjunto {
  id          String    @id @default(cuid())
  conjuntoId  String
  entidad     String
  entidadId   String
  url         String
  nombre      String
  mime        String
  tamano      Int
  subidoPorId String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([conjuntoId, entidad, entidadId])
}

model ImportacionApertura {
  id            String            @id @default(cuid())
  conjuntoId    String
  tipo          String // UNIDADES | PROPIETARIOS | SALDOS | ZONAS | PARQUEADEROS | USUARIOS
  archivoNombre String
  estado        EstadoImportacion @default(VALIDANDO)
  totalFilas    Int               @default(0)
  filasOk       Int               @default(0)
  filasError    Int               @default(0)
  errores       Json              @default("[]")
  resumen       Json?
  creadoPorId   String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  deletedAt     DateTime?

  @@index([conjuntoId])
}

model ConfiguracionIntegracion {
  id              String          @id @default(cuid())
  conjuntoId      String?
  tipo            TipoIntegracion
  datosCifrados   String
  activo          Boolean         @default(true)
  ultimaPrueba    DateTime?
  ultimoResultado String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  deletedAt       DateTime?

  @@unique([conjuntoId, tipo])
}

model Backup {
  id         String    @id @default(cuid())
  conjuntoId String
  archivoUrl String
  tamano     Int
  registros  Int
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  @@index([conjuntoId])
}

model ConsultaIA {
  id         String    @id @default(cuid())
  conjuntoId String
  usuarioId  String
  tipo       String // PREGUNTA_REGLAMENTO | BORRADOR_PQRS | RESUMEN_ACTA
  pregunta   String
  respuesta  String
  tokens     Int       @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  @@index([conjuntoId])
}
