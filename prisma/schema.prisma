}

model VinculoUnidad {
  id                  String          @id @default(cuid())
  conjuntoId          String
  conjunto            Conjunto        @relation(fields: [conjuntoId], references: [id])
  personaId           String
  persona             Persona         @relation(fields: [personaId], references: [id])
  unidadId            String
  unidad              Unidad          @relation(fields: [unidadId], references: [id])
  tipo                TipoVinculo
  porcentajePropiedad Decimal?        @db.Decimal(5, 2)
  fechaInicio         DateTime        @default(now())
  fechaFin            DateTime?
  principal           Boolean         @default(false)
  horarioPermitido    Json? // { dias:[1,2,3], desde:"07:00", hasta:"17:00" }
  estado              EstadoVinculo   @default(ACTIVO)
  puedeVerCuenta      Boolean         @default(false)
  aprobadoPorId       String?
  /// Acceso derivado: vínculo del titular que otorgó este acceso (si el titular sale, este acceso termina).
  derivadoDeId        String?
  derivadoDe          VinculoUnidad?  @relation("AccesoDerivado", fields: [derivadoDeId], references: [id])
  derivados           VinculoUnidad[] @relation("AccesoDerivado")
  /// Capacidades que el titular le dio en la app (ver lib/hogar/capacidades.ts). Vacío = sin restricción adicional.
  capacidadesHogar    String[]        @default([])
  /// El titular pausó temporalmente el acceso a la app (el vínculo físico sigue activo).
  accesoPausado       Boolean         @default(false)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  deletedAt           DateTime?

  @@index([conjuntoId])
  @@index([unidadId])
  @@index([personaId])
  @@index([derivadoDeId])
}

