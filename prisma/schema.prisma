  membresias    MembresiaConjunto[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  deletedAt     DateTime?

  @@unique([conjuntoId, clave])
  @@index([conjuntoId])
}

model Permiso {
  id          String    @id @default(cuid())
  clave       String    @unique // modulo.accion
  modulo      String
  accion      String
  descripcion String
  tipo        String    @default("ACCION") // ACCION | CAMPO | SECCION
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
}

model RolPermiso {
  id           String    @id @default(cuid())
  conjuntoId   String
  rolId        String
  rol          Rol       @relation(fields: [rolId], references: [id], onDelete: Cascade)
  permisoClave String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  @@unique([rolId, permisoClave])
  @@index([conjuntoId])
}

model TokenVerificacion {
