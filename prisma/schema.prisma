  updatedAt          DateTime     @updatedAt
  deletedAt          DateTime?

  @@index([conjuntoId])
}

model Cuota {
  id                    String           @id @default(cuid())
  conjuntoId            String
  conjunto              Conjunto         @relation(fields: [conjuntoId], references: [id])
  unidadId              String
  unidad                Unidad           @relation(fields: [unidadId], references: [id])
  conceptoId            String
  concepto              ConceptoCobro    @relation(fields: [conceptoId], references: [id])
  periodo               String // YYYY-MM
  descripcion           String?
  fechaEmision          DateTime
  fechaVencimiento      DateTime
  fechaProntoPago       DateTime?
  porcentajeProntoPago  Decimal          @default(0) @db.Decimal(5, 2)
  valorBase             Decimal          @db.Decimal(14, 2)
  iva                   Decimal          @default(0) @db.Decimal(14, 2)
  descuento             Decimal          @default(0) @db.Decimal(14, 2)
  interes               Decimal          @default(0) @db.Decimal(14, 2) // intereses causados sobre esta cuota (informativo)
  saldo                 Decimal          @db.Decimal(14, 2)
  estado                EstadoCuota      @default(PENDIENTE)
  referenciaPago        String           @unique
  origen                OrigenCuota      @default(MANUAL)
  cuotaExtraordinariaId String?
  cuotaOrigenId         String? // para cuotas de interés: cuota que lo generó
  acuerdoId             String?
  interesCausadoHasta   DateTime?
  aplicaciones          AplicacionPago[]
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  deletedAt             DateTime?

  @@index([conjuntoId])
  @@index([unidadId, estado])
  @@index([conjuntoId, periodo])
}

