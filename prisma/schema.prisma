// MiConjunto — modelo de datos
// Convención: modelos y campos de dominio en español (vocabulario de propiedad horizontal),
// todo modelo de negocio tiene conjuntoId + borrado lógico (deletedAt).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

