// ─────────────────────────────── SAAS ───────────────────────────────

model PlanSuscripcion {
  id            String        @id @default(cuid())
  nombre        String
  descripcion   String?
  precioMensual Decimal       @db.Decimal(14, 2)
  precioUnidad  Decimal       @default(0) @db.Decimal(14, 2)
  maxUnidades   Int
  modulos       String[]
  activo        Boolean       @default(true)
  conjuntos     Conjunto[]
  suscripciones Suscripcion[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?
}

model Suscripcion {
  id         String             @id @default(cuid())
  conjuntoId String
  conjunto   Conjunto           @relation(fields: [conjuntoId], references: [id])
  planId     String
  plan       PlanSuscripcion    @relation(fields: [planId], references: [id])
  estado     EstadoSuscripcion  @default(ACTIVA)
  inicio     DateTime
  fin        DateTime?
  valor      Decimal            @db.Decimal(14, 2)
  notas      String?
  cobros     CobroSuscripcion[]
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  deletedAt  DateTime?

  @@index([conjuntoId])
}

model CobroSuscripcion {
  id            String      @id @default(cuid())
  suscripcionId String
  suscripcion   Suscripcion @relation(fields: [suscripcionId], references: [id])
  periodo       String
  valor         Decimal     @db.Decimal(14, 2)
  pagado        Boolean     @default(false)
  pagadoEn      DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  deletedAt     DateTime?
}

// ─────────────────────────────── NÚCLEO ───────────────────────────────

model Conjunto {
  id                    String           @id @default(cuid())
  nombre                String
  slug                  String           @unique
  nit                   String?
  digitoVerificacion    String?
  direccion             String?
  municipioCodigo       String? // DIVIPOLA
  ciudad                String?
  departamento          String?
  telefono              String?
  email                 String?
  logoUrl               String?
  colorPrimario         String?          @default("#0f766e")
  regimenTributario     String?
  responsableIva        Boolean          @default(false)
  tipo                  TipoConjunto     @default(MIXTO)
  matriculaInmobiliaria String?
  personeriaJuridica    String?
  fechaInicioOperacion  DateTime?
  planId                String?
  plan                  PlanSuscripcion? @relation(fields: [planId], references: [id])
  estado                EstadoConjunto   @default(ACTIVO)
  config                Json             @default("{}")
  paginaPublica         Boolean          @default(false)
  descripcionPublica    String?
  modulosActivos        String[]
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  deletedAt             DateTime?

  suscripciones   Suscripcion[]
  torres          Torre[]
  unidades        Unidad[]
  parqueaderos    Parqueadero[]
  bodegas         Bodega[]
  zonas           ZonaComun[]
  membresias      MembresiaConjunto[]
  roles           Rol[]
  personas        Persona[]
  vinculos        VinculoUnidad[]
  vehiculos       Vehiculo[]
  mascotas        Mascota[]
  conceptos       ConceptoCobro[]
  cuotas          Cuota[]
  pagos           Pago[]
  reservas        Reserva[]
  tickets         Ticket[]
  paquetes        Paquete[]
  registrosAcceso RegistroAcceso[]
  publicaciones   Publicacion[]
  activos         Activo[]
  proveedores     Proveedor[]
  asambleas       Asamblea[]
  votaciones      Votacion[]
  auditorias      Auditoria[]
}

model Torre {
  id              String    @id @default(cuid())
  conjuntoId      String
  conjunto        Conjunto  @relation(fields: [conjuntoId], references: [id])
  nombre          String
  pisos           Int       @default(1)
  unidadesPorPiso Int?
  ascensores      Boolean   @default(false)
  notas           String?
  unidades        Unidad[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  @@unique([conjuntoId, nombre])
  @@index([conjuntoId])
}

model Unidad {
  id                            String          @id @default(cuid())
  conjuntoId                    String
  conjunto                      Conjunto        @relation(fields: [conjuntoId], references: [id])
  torreId                       String?
  torre                         Torre?          @relation(fields: [torreId], references: [id])
  codigo                        String // "T2-501", "Casa 14"
  tipo                          TipoUnidad      @default(APARTAMENTO)
  piso                          Int?
  areaPrivada                   Decimal?        @db.Decimal(10, 2)
  areaConstruida                Decimal?        @db.Decimal(10, 2)
  coeficiente                   Decimal         @db.Decimal(9, 6)
  matriculaInmobiliaria         String?
  numeroCatastral               String?
  estrato                       Int?
  habitaciones                  Int?
  banos                         Int?
  balconTerraza                 Boolean         @default(false)
  estadoOcupacion               EstadoOcupacion @default(PROPIETARIO_OCUPA)
  plataformaRentaCorta          String?
  registroRnt                   String?
  cuotaAdministracion           Decimal         @default(0) @db.Decimal(14, 2)
  notasEstructura               String?
  medidores                     Json            @default("{}")
  tienePersonaMovilidadReducida Boolean         @default(false)
  requiereAsistenciaEvacuacion  Boolean         @default(false)
  createdAt                     DateTime        @default(now())
  updatedAt                     DateTime        @updatedAt
  deletedAt                     DateTime?

  vinculos        VinculoUnidad[]
  vehiculos       Vehiculo[]
  mascotas        Mascota[]
  parqueaderos    Parqueadero[]
  bodegas         Bodega[]
  cuotas          Cuota[]
  pagos           Pago[]
  movimientos     MovimientoCartera[]
  reservas        Reserva[]
  paquetes        Paquete[]
  tickets         Ticket[]
  autorizaciones  AutorizacionIngreso[]
  registrosAcceso RegistroAcceso[]
  multas          Multa[]
  llamados        LlamadoAtencion[]
  historialCoef   HistorialCoeficiente[]
  certificados    CertificadoPazYSalvo[]
  acuerdos        AcuerdoPago[]
  gestionesCobro  GestionCobro[]
  asistencias     AsistenciaAsamblea[]
  votos           Voto[]
  obras           SolicitudObra[]
  mudanzas        Mudanza[]

  @@unique([conjuntoId, codigo])
  @@index([conjuntoId])
  @@index([torreId])
}

model HistorialCoeficiente {
  id         String    @id @default(cuid())
  conjuntoId String
  unidadId   String
  unidad     Unidad    @relation(fields: [unidadId], references: [id])
  anterior   Decimal   @db.Decimal(9, 6)
  nuevo      Decimal   @db.Decimal(9, 6)
  motivo     String?
  usuarioId  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  @@index([conjuntoId])
}

model Parqueadero {
  id         String          @id @default(cuid())
  conjuntoId String
  conjunto   Conjunto        @relation(fields: [conjuntoId], references: [id])
  codigo     String
  tipo       TipoParqueadero @default(PRIVADO)
  ubicacion  String?
  unidadId   String?
  unidad     Unidad?         @relation(fields: [unidadId], references: [id])
  estado     EstadoEspacio   @default(DISPONIBLE)
  tarifaHora Decimal?        @db.Decimal(14, 2)
  tarifaDia  Decimal?        @db.Decimal(14, 2)
  notas      String?
  vehiculos  Vehiculo[]
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  deletedAt  DateTime?

  @@unique([conjuntoId, codigo])
  @@index([conjuntoId])
}

model Bodega {
  id         String        @id @default(cuid())
  conjuntoId String
  conjunto   Conjunto      @relation(fields: [conjuntoId], references: [id])
  codigo     String
  ubicacion  String?
  area       Decimal?      @db.Decimal(10, 2)
  unidadId   String?
  unidad     Unidad?       @relation(fields: [unidadId], references: [id])
  estado     EstadoEspacio @default(DISPONIBLE)
  notas      String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  deletedAt  DateTime?

  @@unique([conjuntoId, codigo])
  @@index([conjuntoId])
}

model ZonaComun {
  id                        String        @id @default(cuid())
  conjuntoId                String
  conjunto                  Conjunto      @relation(fields: [conjuntoId], references: [id])
  nombre                    String
  tipo                      String?
  categoria                 CategoriaZona @default(OTRA)
  descripcion               String?
  fotos                     String[]
  capacidad                 Int?
  horario                   Json          @default("{}") // { "1": {"abre":"08:00","cierra":"22:00"}, ... } 0=domingo
  reservable                Boolean       @default(true)
  requiereAprobacion        Boolean       @default(false)
  tarifa                    Decimal       @default(0) @db.Decimal(14, 2)
  deposito                  Decimal       @default(0) @db.Decimal(14, 2)
  duracionMinimaMin         Int           @default(60)
  duracionMaximaMin         Int           @default(240)
  anticipacionMinimaHoras   Int           @default(24)
  anticipacionMaximaDias    Int           @default(60)
  maxReservasMesUnidad      Int           @default(4)
  reglasUso                 String?
  bloqueoPorMora            Boolean       @default(true)
  gravaIva                  Boolean       @default(false)
  tarifaIva                 Decimal       @default(19) @db.Decimal(5, 2)
  generaFactura             Boolean       @default(false)
  politicaCancelacion       String?
  horasCancelacionReembolso Int           @default(48)
  estado                    EstadoZona    @default(ACTIVA)
  createdAt                 DateTime      @default(now())
  updatedAt                 DateTime      @updatedAt
  deletedAt                 DateTime?

  reservas Reserva[]
  bloqueos BloqueoZona[]
  reglas   ReglaReserva[]
  tickets  Ticket[]
  activos  Activo[]

  @@index([conjuntoId])
}

model BloqueoZona {
  id         String    @id @default(cuid())
  conjuntoId String
  zonaId     String
  zona       ZonaComun @relation(fields: [zonaId], references: [id])
  inicio     DateTime
  fin        DateTime
  motivo     String
  tipo       String    @default("MANTENIMIENTO") // MANTENIMIENTO | EVENTO | FESTIVO | OTRO
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  @@index([conjuntoId, zonaId])
}

model ReglaReserva {
  id          String    @id @default(cuid())
  conjuntoId  String
  zonaId      String
  zona        ZonaComun @relation(fields: [zonaId], references: [id])
  tipo        String // SOLO_FINES_SEMANA | UN_TURNO_POR_DIA | DIAS_PERMITIDOS | MAX_ASISTENTES
  valor       Json      @default("{}")
  descripcion String?
  activa      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([conjuntoId, zonaId])
}

// ─────────────────────────────── USUARIOS, ROLES ───────────────────────────────

model Usuario {
  id                 String        @id @default(cuid())
  email              String        @unique
  telefono           String?
  passwordHash       String?
  nombre             String
  fotoUrl            String?
  estado             EstadoUsuario @default(ACTIVO)
  ultimoAcceso       DateTime?
  preferenciasNotif  Json          @default("{\"push\":true,\"email\":true,\"whatsapp\":false}")
  politicaAceptadaEn DateTime?
  politicaVersion    String?
  mfaSecret          String?
  mfaActivo          Boolean       @default(false)
  esSuperAdmin       Boolean       @default(false)
  intentosFallidos   Int           @default(0)
