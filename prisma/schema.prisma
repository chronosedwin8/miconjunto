model MembresiaConjunto {
  id         String          @id @default(cuid())
  usuarioId  String
  usuario    Usuario         @relation(fields: [usuarioId], references: [id])
  conjuntoId String
  conjunto   Conjunto        @relation(fields: [conjuntoId], references: [id])
  rolId      String
  rol        Rol             @relation(fields: [rolId], references: [id])
  personaId  String?
  estado     EstadoMembresia @default(ACTIVA)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  deletedAt  DateTime?

  @@unique([usuarioId, conjuntoId])
  @@index([conjuntoId])
}

model Rol {
  id            String              @id @default(cuid())
  conjuntoId    String
  conjunto      Conjunto            @relation(fields: [conjuntoId], references: [id])
  clave         String // ADMINISTRADOR, PORTERIA... o personalizado
  nombre        String
  descripcion   String?
